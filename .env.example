# Campus OS Backend — Environment Variables
# Copy this file to .env and fill in all values before running.

# ─── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development           # development | production

# ─── CORS (production only) ────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Leave empty to allow all origins (development / mobile APK).
ALLOWED_ORIGINS=https://app.example.com,https://campus.example.com

# ─── MongoDB ───────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/student-os?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────
# Use a strong random secret (32+ characters). Never commit real values.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_32CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_REFRESH_SECRET

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ─── Firebase Admin SDK ────────────────────────────────────────
# Paste the full JSON string of your Firebase service account key.
FIREBASE_SERVICE_ACCOUNT='{ ... firebase service account JSON ... }'

# ─── Cloudflare R2 Storage ─────────────────────────────────────
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret-key>
R2_BUCKET_NAME=<bucket-name>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-r2-subdomain>.r2.dev

# ─── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=<your-resend-api-key>
# Legacy nodemailer (optional fallback)
EMAIL_USER=<smtp-email>
EMAIL_PASS=<smtp-password>

# ─── AI Services ───────────────────────────────────────────────
GEMINI_API_KEY=<your-gemini-api-key>
OPENAI_API_KEY=<your-openai-api-key>
DEEPSEEK_API_KEY=<your-deepseek-api-key>
PERPLEXITY_API_KEY=<your-perplexity-api-key>

# ─── Logging ───────────────────────────────────────────────────
# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ─── npm ───────────────────────────────────────────────────────
NPM_CONFIG_LEGACY_PEER_DEPS=true
